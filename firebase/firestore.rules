rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == 'admin'; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }
    match /drivers/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }
    match /vehicles/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.resource.data.driverId == request.auth.uid);
    }
    match /bookings/{id} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.driverId == request.auth.uid || isAdmin());
    }
    match /payments/{id} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    match /transactions/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /ratings/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }
    match /complaints/{id} {
      allow read, write: if isSignedIn();
    }
    match /offers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /fareSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /notifications/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /adminUsers/{uid} {
      allow read, write: if isAdmin();
    }
    match /driverLocations/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }
  }
}
